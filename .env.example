# MCP Server configuration
# All values shown are the defaults — uncomment and edit to override.

# TCP port used by the Streamable HTTP transport.
MCP_PORT=3333

# Bind address used by the Streamable HTTP transport.
# MCP_LISTENING_ADDRESS=127.0.0.1

# Transport mode. Valid values: stdio | Streamable_HTTP
MCP_COMMUNICATION=Streamable_HTTP

#
# Required Tools configs (if using them)
#
### Tools
DB_URL=<URL>
DB_NAME=<your db name>
DB_USER=<your username>
DB_PASSWORD=<your password>

